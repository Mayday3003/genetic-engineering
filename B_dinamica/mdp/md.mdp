title                   = Produccion 1 ns (System_2A / System_2B)
; Basado en md.mdp del tutorial (mdtutorials.com/gmx/lysozyme) con los mismos
; parametros no enlazantes, termostato y barostato que nvt.mdp / npt.mdp de clase.
; Run parameters
integrator              = md        ; leap-frog integrator
nsteps                  = 500000    ; 2 * 500000 = 1000 ps (1 ns)
dt                      = 0.002     ; 2 fs
; Output control
nstxout                 = 0         ; no guardar coordenadas en .trr (ocupa mucho)
nstvout                 = 0         ; no guardar velocidades
nstfout                 = 0         ; no guardar fuerzas
nstenergy               = 500       ; save energies every 1.0 ps
nstlog                  = 5000      ; update log file every 10.0 ps
nstxout-compressed      = 500       ; coordenadas en .xtc cada 1.0 ps (1000 frames)
compressed-x-grps       = System    ; sistema completo (lo necesita gmx_MMPBSA)
; Bond parameters
continuation            = yes       ; Restarting after NPT
constraint_algorithm    = lincs     ; holonomic constraints
constraints             = h-bonds   ; bonds involving H are constrained
lincs_iter              = 1         ; accuracy of LINCS
lincs_order             = 4         ; also related to accuracy
; Neighbor searching and vdW
cutoff-scheme           = Verlet    ; Buffered neighbor searching
ns_type                 = grid      ; search neighboring grid cells
nstlist                 = 10        ; 20 fs, largely irrelevant with Verlet scheme
rvdw                    = 1.2       ; short-range van der Waals cutoff (in nm)
rvdw-switch             = 1.0
vdw-modifier            = force-switch
DispCorr                = No
; Electrostatics
rcoulomb                = 1.2       ; short-range electrostatic cutoff (in nm)
coulombtype             = PME       ; Particle Mesh Ewald for long-range electrostatics
pme_order               = 4         ; cubic interpolation
fourierspacing          = 0.16      ; grid spacing for FFT
; Temperature coupling
tcoupl                  = V-rescale ; stochastic Bussi thermostat
tc-grps                 = System
tau_t                   = 1.0
ref_t                   = 298
; Pressure coupling (sin -DPOSRES: produccion sin restricciones)
pcoupl                  = C-rescale
pcoupltype              = isotropic             ; uniform scaling of box vectors
tau_p                   = 5.0                   ; time constant, in ps
ref_p                   = 1.0                   ; reference pressure, in bar
compressibility         = 4.5e-5                ; isothermal compressibility of water, bar^-1
; Periodic boundary conditions
pbc                     = xyz       ; 3-D PBC
; Velocity generation
gen_vel                 = no        ; continuar las velocidades del NPT
